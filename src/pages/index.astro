---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="max-w-4xl mx-auto px-4 py-16">
      <h1 class="text-4xl font-bold mb-4">Calvin Bergin</h1>
      <p class="text-xl text-gray-600 mb-8">
        Automation/AI Engineer
      </p>

      <div class="prose prose-lg max-w-none">
        <p>
          I force even the worst of APIs to play nice, by force... and also have enough Microsoft Exams to qualify as a small exam center.
        </p>

        <p>
          This blog covers: Microsoft tooling, Azure, Automation at scale, and occasionally shitposting-as-code (SAC).
        </p>

        <h2>Recent Posts</h2>
      </div>

      <!-- Blog posts will appear here automatically -->
      <div class="mt-8">
        <a href="/blog" class="text-blue-600 hover:underline text-lg">
          View all posts →
        </a>
      </div>
    </main>
    <Footer />
  </body>
</html>
