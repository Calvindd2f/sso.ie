---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="max-w-4xl mx-auto px-4 py-16">
      <h1 class="text-4xl font-bold mb-4">Calvin Carey</h1>
      <p class="text-xl text-gray-600 mb-8">
        Automation/AI Engineer @ Intuity Technologies | Security Researcher |
        MSP Infrastructure
      </p>

      <div class="prose prose-lg max-w-none">
        <p>
          I manage automation across 177+ Microsoft 365 tenants and spend my
          free time finding security implications in enterprise cloud
          infrastructure.
        </p>

        <p>
          This blog covers: reverse engineering Microsoft tooling, Azure
          offensive security, MSP automation at scale, and occasionally breaking
          things in production.
        </p>

        <h2>Recent Posts</h2>
      </div>

      <!-- Blog posts will appear here automatically -->
      <div class="mt-8">
        <a href="/blog" class="text-blue-600 hover:underline text-lg">
          View all posts →
        </a>
      </div>
    </main>
    <Footer />
  </body>
</html>
